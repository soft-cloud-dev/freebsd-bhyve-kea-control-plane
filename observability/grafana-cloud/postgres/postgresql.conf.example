# Required PostgreSQL settings for Grafana Cloud Database Observability.
# Merge these values into the active postgresql.conf. Do not replace unrelated
# settings. shared_preload_libraries and track_activity_query_size require a
# PostgreSQL restart when changed.

shared_preload_libraries = 'pg_stat_statements'
compute_query_id = on
pg_stat_statements.track = all
track_activity_query_size = 4096
