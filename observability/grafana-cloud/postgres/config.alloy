// Grafana Cloud Database Observability for the BKCP PostgreSQL database.
//
// Requirements:
//   - Grafana Alloy 1.17.0 or later.
//   - /usr/local/etc/alloy/postgres.dsn contains the db-o11y DSN.
//   - the GCLOUD_* and BKCP_DB_INSTANCE variables are exported to Alloy.
//   - Alloy connects directly to PostgreSQL, not through PgBouncer or a load balancer.
//
// Query samples remain redacted. PostgreSQL log ingestion is intentionally not
// enabled here because FreeBSD installations may use files or syslog. Add a
// loki.source.file or loki.source.syslog component only after the site's logging
// destination and access policy are explicit.

logging {
	level  = "info"
	format = "logfmt"
}

local.file "postgres_secret_bkcp" {
	filename  = "/usr/local/etc/alloy/postgres.dsn"
	is_secret = true
}

prometheus.exporter.postgres "postgres_bkcp" {
	data_source_names  = [local.file.postgres_secret_bkcp.content]
	enabled_collectors = ["stat_statements"]

	stat_statements {
		exclude_users = ["db-o11y"]
	}

	autodiscovery {
		enabled = true
	}
}

database_observability.postgres "postgres_bkcp" {
	data_source_name = local.file.postgres_secret_bkcp.content
	forward_to       = [loki.relabel.database_observability_postgres_bkcp.receiver]
	targets          = prometheus.exporter.postgres.postgres_bkcp.targets

	enable_collectors    = ["query_details", "query_samples", "schema_details", "explain_plans"]
	disable_collectors   = ["logs"]
	exclude_users        = ["db-o11y"]
	exclude_current_user = true

	query_samples {
		disable_query_redaction = false
	}
}

loki.relabel "database_observability_postgres_bkcp" {
	forward_to = [loki.write.logs_service.receiver]

	rule {
		target_label = "job"
		replacement  = "integrations/db-o11y"
	}

	// Preserve the original exporter target for Database Observability correlation.
	rule {
		source_labels = ["instance"]
		target_label  = "dsn"
	}

	rule {
		target_label = "instance"
		replacement  = sys.env("BKCP_DB_INSTANCE")
	}
}

discovery.relabel "database_observability_postgres_bkcp" {
	targets = database_observability.postgres.postgres_bkcp.targets

	rule {
		target_label = "job"
		replacement  = "integrations/db-o11y"
	}

	// Preserve the original exporter target for Database Observability correlation.
	rule {
		source_labels = ["instance"]
		target_label  = "dsn"
	}

	rule {
		target_label = "instance"
		replacement  = sys.env("BKCP_DB_INSTANCE")
	}
}

prometheus.scrape "database_observability_postgres_bkcp" {
	targets         = discovery.relabel.database_observability_postgres_bkcp.output
	job_name        = "integrations/db-o11y"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.metrics_service.receiver]
}

// Forward the existing BKCP control-plane metrics to the same Grafana Cloud
// metrics tenant. This leaves cpctl metrics loopback-bound.
discovery.relabel "bkcp_control_plane" {
	targets = [{
		__address__ = "127.0.0.1:9188",
	}]

	rule {
		target_label = "job"
		replacement  = "bkcp"
	}

	rule {
		target_label = "instance"
		replacement  = sys.env("BKCP_DB_INSTANCE")
	}
}

prometheus.scrape "bkcp_control_plane" {
	targets         = discovery.relabel.bkcp_control_plane.output
	job_name        = "bkcp"
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.metrics_service.receiver]
}

prometheus.remote_write "metrics_service" {
	endpoint {
		url = sys.env("GCLOUD_HOSTED_METRICS_URL")

		basic_auth {
			username = sys.env("GCLOUD_HOSTED_METRICS_ID")
			password = sys.env("GCLOUD_RW_API_KEY")
		}
	}
}

loki.write "logs_service" {
	endpoint {
		url = sys.env("GCLOUD_HOSTED_LOGS_URL")

		basic_auth {
			username = sys.env("GCLOUD_HOSTED_LOGS_ID")
			password = sys.env("GCLOUD_RW_API_KEY")
		}
	}
}
