# Copy to /usr/local/etc/alloy/grafana-cloud.env, replace every value, set
# ownership to root:alloy, and chmod 0640. This file uses /bin/sh syntax.

BKCP_DB_INSTANCE='bkcp-postgres-01'

GCLOUD_HOSTED_METRICS_URL='https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push'
GCLOUD_HOSTED_METRICS_ID='REPLACE_WITH_METRICS_TENANT_ID'

GCLOUD_HOSTED_LOGS_URL='https://logs-prod-XXX.grafana.net/loki/api/v1/push'
GCLOUD_HOSTED_LOGS_ID='REPLACE_WITH_LOGS_TENANT_ID'

# Use a Grafana Cloud access policy token limited to metrics:write and logs:write.
GCLOUD_RW_API_KEY='REPLACE_WITH_ACCESS_POLICY_TOKEN'
