STORK_DATABASE_HOST=127.0.0.1
STORK_DATABASE_PORT=5432
STORK_DATABASE_NAME=@STORK_DB_NAME@
STORK_DATABASE_USER_NAME=@STORK_DB_USER@
STORK_DATABASE_PASSWORD=@STORK_DB_PASSWORD@
STORK_DATABASE_SSLMODE=disable

STORK_REST_HOST=@MGMT_ADDR@
STORK_REST_PORT=8080
STORK_REST_STATIC_FILES_DIR=/usr/local/share/stork/www
STORK_SERVER_ENABLE_METRICS=false

STORK_LOG_LEVEL=INFO
CLICOLOR=false
