hostname="bhyve01.example.net"

zfs_enable="YES"
sshd_enable="YES"
blacklistd_enable="YES"
pf_enable="YES"
pf_rules="/etc/pf.conf"
pflog_enable="YES"

vm_enable="YES"
vm_dir="zfs:zroot/vm"

postgresql_enable="YES"
kea_dhcp4_enable="YES"

prometheus_enable="YES"
prometheus_config="/usr/local/etc/prometheus.yml"
prometheus_args="--web.listen-address=127.0.0.1:9090"

node_exporter_enable="YES"
node_exporter_listen_address="127.0.0.1:9100"

postgres_exporter_enable="YES"
postgres_exporter_listen_address="127.0.0.1:9187"
postgres_exporter_env="DATA_SOURCE_URI=postgresql://prometheus@/inventory?host=/tmp&sslmode=disable"

grafana_enable="YES"
grafana_config="/usr/local/etc/grafana/grafana.ini"

loki_enable="YES"
loki_config="/usr/local/etc/loki.yml"

# Example physical and bridge configuration; replace interface names and addresses.
cloned_interfaces="bridge0 vlan10"
ifconfig_vlan10="inet 10.0.10.2/24 vlan 10 vlandev igb0"
ifconfig_bridge0="inet 10.0.20.1/24 up"
