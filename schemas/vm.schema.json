{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soft-cloud.dev/schemas/bkcp/vm-v1.schema.json",
  "title": "BKCP VM manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "owner", "image", "profile", "pool", "desired_power", "cpus", "memory_mb", "disk_gb"],
  "properties": {
    "schema": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "owner": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "pool": {"type": "string", "minLength": 1},
    "desired_power": {"enum": ["running", "stopped"]},
    "cpus": {"type": "integer", "minimum": 1, "maximum": 64},
    "memory_mb": {"type": "integer", "minimum": 128},
    "disk_gb": {"type": "integer", "minimum": 1},
    "ssh_public_key_file": {"type": "string", "pattern": "^/"}
  }
}
